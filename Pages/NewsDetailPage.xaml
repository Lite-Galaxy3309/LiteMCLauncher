<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LiteMCLauncher.Pages.NewsDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LiteMCLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="32,16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                AutomationProperties.Name="返回新闻列表"
                Click="BackButton_Click">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="HeaderTitle"
                    MaxLines="1"
                    Style="{StaticResource CardTitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="HeaderMeta"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Click="BrowserButton_Click"
                Content="在浏览器打开" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                x:Name="ArticlePanel"
                MaxWidth="980"
                Padding="32,24,32,40"
                HorizontalAlignment="Left"
                Spacing="12" />
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            Width="44"
            Height="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />
    </Grid>
</Page>
