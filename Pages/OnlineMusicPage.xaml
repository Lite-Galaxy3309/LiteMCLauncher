<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LiteMCLauncher.Pages.OnlineMusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LiteMCLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LiteMCLauncher.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="HistoryDialogItemTemplate" x:DataType="models:OnlineHistoryItem">
            <Grid Margin="0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxLines="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind PlayedAtDisplay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="DeleteHistoryItem_Click"
                    Content="删除" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="在线音乐" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                    Text="播放器与历史记录；搜索和登录已移到单独的搜索页面。" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OpenSearch_Click"
                Content="搜索"
                Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing
                Grid.Column="2"
                Width="28"
                Height="28"
                VerticalAlignment="Center"
                IsActive="{x:Bind Online.IsSearching, Mode=OneWay}" />
        </Grid>

        <Border
            Grid.Row="1"
            Padding="24"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="280"
                    Height="280"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="14">
                    <Image
                        Source="{x:Bind Online.CurrentCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                        Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock
                        Style="{StaticResource PageTitleTextBlockStyle}"
                        Text="{x:Bind Online.CurrentTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Online.CurrentArtist, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Online.CurrentAlbum, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            AutomationProperties.Name="上一首"
                            Click="Previous_Click"
                            Padding="14">
                            <FontIcon FontSize="20" Glyph="&#xE892;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="播放或暂停"
                            Click="PlayPause_Click"
                            Padding="20"
                            Style="{StaticResource AccentButtonStyle}">
                            <FontIcon FontSize="26" Glyph="{x:Bind Online.PlayPauseGlyph, Mode=OneWay}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="下一首"
                            Click="Next_Click"
                            Padding="14">
                            <FontIcon FontSize="20" Glyph="&#xE893;" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="PlaybackMode_Click">
                            <TextBlock Text="{x:Bind Online.PlaybackModeDisplay, Mode=OneWay}" />
                        </Button>
                        <Button Click="OpenHistory_Click" Content="历史播放" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Online.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
