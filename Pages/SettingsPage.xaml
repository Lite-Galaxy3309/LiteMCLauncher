<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LiteMCLauncher.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LiteMCLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,24" Spacing="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="设置" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleTextBlockStyle}"
                        Text="调整游戏运行参数、下载源与启动器外观。" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="保存设置"
                    Click="SaveSettings_Click"
                    Content="保存设置"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <!--  启动器语言  -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="0">
                    <StackPanel Margin="0,0,0,4" Spacing="2">
                        <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="启动器" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="切换启动器界面使用的语言，不会影响游戏内语言。" />
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="界面语言" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="保存后立即切换，重启启动器后保持。" />
                        </StackPanel>
                        <ComboBox
                            x:Name="LauncherLanguageBox"
                            Grid.Column="1"
                            Width="260"
                            SelectedIndex="0">
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  游戏  -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="0">
                    <StackPanel Margin="0,0,0,4" Spacing="2">
                        <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="游戏" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="这些设置将作为新实例的默认值。" />
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Java 路径" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="留空时自动检测已安装的 Java。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBox
                                x:Name="JavaPathBox"
                                Width="260"
                                PlaceholderText="自动检测" />
                            <Button Click="BrowseJavaPath_Click" Content="浏览" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="最大内存" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="建议设置为系统内存的 50% 左右。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <NumberBox
                                x:Name="MaxMemoryBox"
                                Width="140"
                                Maximum="32768"
                                Minimum="1024"
                                SmallChange="512"
                                SpinButtonPlacementMode="Compact"
                                Value="4096" />
                            <TextBlock VerticalAlignment="Center" Text="MB" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="游戏语言" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="仅影响游戏内显示的语言。" />
                        </StackPanel>
                        <ComboBox
                            x:Name="GameLanguageBox"
                            Grid.Column="1"
                            Width="260"
                            SelectedIndex="0">
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="繁體中文" />
                            <ComboBoxItem Content="English (US)" />
                            <ComboBoxItem Content="日本語" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="额外 JVM 参数" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="多个参数之间使用空格分隔。" />
                        </StackPanel>
                        <TextBox
                            x:Name="JvmArgumentsBox"
                            Grid.Column="1"
                            Width="260"
                            PlaceholderText="-XX:+UseG1GC" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Java 运行时  -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="Java 管理" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="可切换清华 TUNA 镜像和 Adoptium 官方源；国内网络推荐镜像，挂代理时可选官方源。也可以直接使用本机已安装的 Java。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                AutomationProperties.Name="安装 Java 8"
                                Click="InstallJava8_Click"
                                Content="Java 8" />
                            <Button
                                AutomationProperties.Name="安装 Java 17"
                                Click="InstallJava17_Click"
                                Content="Java 17" />
                            <Button
                                AutomationProperties.Name="安装 Java 21"
                                Click="InstallJava21_Click"
                                Content="Java 21" />
                            <Button
                                AutomationProperties.Name="安装 Java 25"
                                Click="InstallJava25_Click"
                                Content="Java 25" />
                            <Button
                                AutomationProperties.Name="打开 Java 目录"
                                Click="OpenJavaFolder_Click"
                                Content="打开目录" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,12,0,0" Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Java 下载源" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="国内网络推荐清华镜像；挂了代理可以选择 Adoptium 官方源。" />
                        </StackPanel>
                        <ComboBox
                            x:Name="JavaSourceBox"
                            Grid.Column="1"
                            Width="320"
                            VerticalAlignment="Center"
                            SelectedIndex="0">
                            <ComboBoxItem Content="清华 TUNA 镜像" />
                            <ComboBoxItem Content="Adoptium 官方源" />
                        </ComboBox>
                    </Grid>

                    <Border Margin="0,12,0,0" Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="默认 Java" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="自动检测，或从已安装的 Java 中指定启动器的默认运行时。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ComboBox
                                x:Name="JavaRuntimeBox"
                                Width="320"
                                DisplayMemberPath="Display"
                                PlaceholderText="自动检测"
                                SelectionChanged="JavaRuntimeBox_SelectionChanged" />
                            <Button Click="AutoDetectJava_Click" Content="自动检测" />
                            <Button Click="RefreshJava_Click" Content="重新检测" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,12,0,0" Style="{StaticResource SeparatorBorderStyle}" />

                    <TextBlock
                        x:Name="JavaStatusText"
                        Margin="0,12,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="正在检测已安装的 Java 运行时…"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  启动器  -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="0">
                    <StackPanel Margin="0,0,0,4" Spacing="2">
                        <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="启动器" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="控制下载、更新与界面行为。" />
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="下载源" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="镜像源可以提升国内网络下的下载速度。" />
                        </StackPanel>
                        <ComboBox
                            x:Name="DownloadSourceBox"
                            Grid.Column="1"
                            Width="260"
                            SelectedIndex="0">
                            <ComboBoxItem Content="Mojang 官方源" />
                            <ComboBoxItem Content="BMCLAPI 镜像" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="界面主题" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="跟随系统时会自动适配 Windows 主题。" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeBox"
                            Grid.Column="1"
                            Width="260"
                            SelectedIndex="0">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="启动游戏后最小化" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="让启动器在游戏启动后自动最小化。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="MinimizeOnLaunchToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  个性化  -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="0">
                    <StackPanel Margin="0,0,0,4" Spacing="2">
                        <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="个性化" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="像 Windows 个性化一样调整透明效果、主题色与背景。" />
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="透明效果" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="开启后使用 Mica 半透明背景；关闭后使用不透明背景。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="TransparencyToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="True" />
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="主题色" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="覆盖系统强调色，应用于按钮、选中项与强调图标。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Border
                                x:Name="AccentColorSwatch"
                                Width="32"
                                Height="32"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16" />
                            <TextBlock
                                x:Name="AccentColorText"
                                MinWidth="90"
                                VerticalAlignment="Center"
                                Text="跟随系统" />
                            <Button Click="PickAccentColor_Click" Content="选择颜色" />
                            <Button Click="ResetAccentColor_Click" Content="恢复默认" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="背景" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="默认使用 Mica，也可以选择纯色或本地图片。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Width="420"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <ComboBox
                                x:Name="BackgroundModeBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="BackgroundMode_SelectionChanged">
                                <ComboBoxItem Content="默认（Mica）" />
                                <ComboBoxItem Content="纯色" />
                                <ComboBoxItem Content="图片" />
                            </ComboBox>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    x:Name="BackgroundColorSwatch"
                                    Width="28"
                                    Height="28"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6" />
                                <Button Click="PickBackgroundColor_Click" Content="背景色" />
                                <Button Click="PickBackgroundImage_Click" Content="选择图片" />
                            </StackPanel>
                            <TextBlock
                                x:Name="BackgroundImageText"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="未选择图片"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  存储  -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="0">
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource CardTitleTextBlockStyle}"
                        Text="存储" />

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="当前游戏目录" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="版本、实例、Mod 与存档都保存在此目录下。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBox
                                x:Name="GameDirectoryBox"
                                Width="280"
                                IsReadOnly="True" />
                            <Button
                                AutomationProperties.Name="打开游戏目录"
                                Click="OpenGameFolder_Click"
                                Content="打开" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SeparatorBorderStyle}" />

                    <Grid Padding="0,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="缓存" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="已下载的库文件与资源缓存，占用约 1.8 GB。" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="ClearCache_Click"
                            Content="清理缓存" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="SettingsStatusText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="修改后点击右上角“保存设置”；Java、内存与 JVM 参数将在下次启动游戏时生效。"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
