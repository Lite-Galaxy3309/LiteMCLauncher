<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LiteMCLauncher.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LiteMCLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LiteMCLauncher.Models"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="音乐" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                    Text="导入本地歌曲，播放列表与自动播放设置。" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="导入歌曲"
                Click="ImportMusic_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                    <TextBlock Text="导入歌曲" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="16"
            Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <ToggleSwitch
                        Header="启动器启动时播放"
                        IsOn="{x:Bind Music.PlayOnLauncherStart, Mode=TwoWay}" />
                    <ToggleSwitch
                        Header="启动游戏时播放"
                        IsOn="{x:Bind Music.PlayOnGameStart, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" MinWidth="330" Spacing="10">
                    <ComboBox
                        x:Name="RepeatModeBox"
                        Width="200"
                        Header="播放模式"
                        HorizontalAlignment="Left"
                        SelectionChanged="RepeatModeBox_SelectionChanged">
                        <ComboBoxItem Content="列表循环" />
                        <ComboBoxItem Content="单曲循环" />
                        <ComboBoxItem Content="随机播放" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="音量" />
                        <Slider
                            Width="190"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.05"
                            Value="{x:Bind Music.Volume, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ListView
            Grid.Row="2"
            Background="Transparent"
            BorderThickness="0"
            IsItemClickEnabled="True"
            ItemClick="MusicList_ItemClick"
            ItemsSource="{x:Bind Music.Tracks}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:MusicTrack">
                    <Border Padding="12" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid>
                                    <FontIcon FontSize="20" Glyph="&#xE8D6;" />
                                    <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Artist}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    MaxLines="1"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Album}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DurationDisplay}" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="RemoveTrack_Click"
                                Content="移除" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Row="3"
            Padding="16"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind Music.HasCurrentTrack, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <Grid>
                        <FontIcon FontSize="20" Glyph="&#xE8D6;" />
                        <Image Source="{x:Bind Music.CurrentAlbumArt, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Music.CurrentTitle, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Music.CurrentArtist, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button Click="Previous_Click" Content="上一首" />
                    <Button Click="PlayPause_Click">
                        <FontIcon Glyph="{x:Bind Music.PlayPauseGlyph, Mode=OneWay}" />
                    </Button>
                    <Button Click="Next_Click" Content="下一首" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
