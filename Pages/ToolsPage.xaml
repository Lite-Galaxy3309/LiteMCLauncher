<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LiteMCLauncher.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LiteMCLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="实用工具" />
            <TextBlock
                Style="{StaticResource PageSubtitleTextBlockStyle}"
                Text="一些方便 Minecraft 游玩的小工具。" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Height="210"
            ColumnSpacing="8"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Height="210"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="CoordinateTool_Click"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Border Padding="20" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource IconTileBorderStyle}">
                            <FontIcon FontSize="24" Glyph="&#xE8EF;" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="坐标计算器" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="主世界/下界坐标互转与距离计算"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Button>

            <Button
                Grid.Column="1"
                Height="210"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="ChunkbaseTool_Click"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Border Padding="20" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource IconTileBorderStyle}">
                            <FontIcon FontSize="24" Glyph="&#xE707;" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="种子查看器" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="内嵌 ChunkBase 种子地图查询"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Button>
        </Grid>
    </Grid>
</Page>
