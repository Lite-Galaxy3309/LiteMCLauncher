<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LiteMCLauncher.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LiteMCLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,24" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="关于" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                    Text="了解 LiteMCLauncher 的版本与作者信息。" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="72"
                        Height="72"
                        Background="Transparent"
                        CornerRadius="18">
                        <Image
                            Source="ms-appx:///Assets/AppIconRounded.png"
                            Stretch="UniformToFill" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="LiteMCLauncher" />
                            <Border Style="{StaticResource PillBorderStyle}">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="v0.2.0" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="一个轻量、现代的 Minecraft 启动器，专注于快速的实例管理与流畅的启动体验。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="版本信息" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="当前版本" />
                        <TextBlock Grid.Column="1" Text="0.2.0" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="构建时间" />
                        <TextBlock Grid.Column="1" Text="2026-11-23" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="发布通道" />
                        <TextBlock Grid.Column="1" Text="Preview" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="作者" />
                        <StackPanel
                            Grid.Column="1"
                            Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Text="Lite" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="该项目使用了 AI，不喜勿喷。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardTitleTextBlockStyle}" Text="免责声明" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="LiteMCLauncher 是独立的第三方启动器，与 Mojang Studios、Microsoft 及 Modrinth 均无隶属或赞助关系。Minecraft 是 Mojang Studios 的商标。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="本项目仅用于学习与个人使用，请在遵守 Minecraft 最终用户许可协议的前提下使用。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
