<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LiteMCLauncher.Pages.ChunkbasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LiteMCLauncher.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                AutomationProperties.Name="Back"
                Click="Back_Click"
                Padding="10">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="种子查看器" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                    Text="内嵌 ChunkBase 种子地图查询。" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <WebView2
                x:Name="WebView"
                Height="600"
                NavigationCompleted="WebView_NavigationCompleted" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                IsActive="True"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
